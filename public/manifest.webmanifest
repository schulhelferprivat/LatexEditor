{"name": "LatexHelper", "short_name": "LatexHelper", "description": "Dein lokaler Arbeitsplatz für LaTeX.", "lang": "de", "start_url": "./", "scope": "./", "display": "standalone", "display_override": ["window-controls-overlay", "standalone", "minimal-ui"], "background_color": "#0f141c", "theme_color": "#0f141c", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"}, {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}], "file_handlers": [{"action": "./", "accept": {"application/x-tex": [".tex"], "text/x-tex": [".tex"]}, "launch_type": "single-client"}], "launch_handler": {"client_mode": "focus-existing"}}