{
  "name": "latexhelper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "dev:windows": "npm run build && npm run build:watch",
    "build": "node scripts/assets.mjs && tsc -b && vite build && node scripts/service-worker.mjs",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "check": "tsc -b",
    "licenses": "node scripts/assets.mjs",
    "test:e2e": "playwright test",
    "package": "node scripts/package.mjs",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "6.11.0",
    "@codemirror/legacy-modes": "6.5.0",
    "@codemirror/lint": "6.8.5",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "@lezer/highlight": "1.2.1",
    "dictionary-de": "3.0.0",
    "dictionary-en": "4.0.0",
    "lucide-react": "0.468.0",
    "nspell": "2.1.5",
    "pdfjs-dist": "5.4.149",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.4.1",
    "license-checker-rseidelsohn": "4.4.2",
    "prettier": "3.9.8",
    "spdx-expression-parse": "3.0.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
